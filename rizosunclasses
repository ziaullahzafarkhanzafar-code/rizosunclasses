<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rizo Sunclasses - Shop Management System</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fdf8f6',
                            100: '#f2e8e5',
                            500: '#c2410c',
                            600: '#9a3412',
                            700: '#7c2d12',
                            800: '#652b19',
                            900: '#532819',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-receipt, #printable-receipt * {
                visibility: visible;
            }
            #printable-receipt {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans antialiased text-slate-800">

    <!-- App Container -->
    <div id="app">
        <!-- Login View -->
        <div id="login-view" class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-800 to-amber-950 p-4">
            <div class="max-w-md w-full bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-700">
                <div class="bg-slate-900 p-6 text-center text-white relative">
                    <div class="absolute top-4 right-4 text-amber-500 text-2xl"><i class="fa-solid fa-glasses"></i></div>
                    <h1 class="text-2xl font-bold tracking-wider">RIZO SUNCLASSES</h1>
                    <p class="text-xs text-slate-400 mt-1">Peshawar Board Bazar | Professional Management System</p>
                </div>
                
                <div class="p-6">
                    <!-- Login Tabs -->
                    <div class="flex rounded-lg bg-slate-100 p-1 mb-6">
                        <button onclick="switchLoginTab('owner')" id="tab-owner" class="flex-1 py-2 text-sm font-semibold rounded-md transition bg-white shadow text-amber-900">Owner Login</button>
                        <button onclick="switchLoginTab('manager')" id="tab-manager" class="flex-1 py-2 text-sm font-semibold rounded-md transition text-slate-600">Manager Login</button>
                    </div>

                    <!-- Owner LoginForm -->
                    <form id="form-owner" onsubmit="handleLogin(event, 'owner')" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-600 mb-1">Owner Username</label>
                            <input type="text" id="owner-user" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-600 outline-none" placeholder="rizwan">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-600 mb-1">Password</label>
                            <input type="password" id="owner-pass" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-600 outline-none" placeholder="••••••••">
                        </div>
                        <button type="submit" class="w-full py-3 bg-amber-700 text-white font-bold rounded-lg hover:bg-amber-800 transition shadow-lg">Login as Owner</button>
                        <p class="text-xs text-center text-slate-500 mt-2">Default: username: <b>rizwan</b> | password: <b>Rizwan@123</b></p>
                    </form>

                    <!-- Manager LoginForm -->
                    <form id="form-manager" onsubmit="handleLogin(event, 'manager')" class="space-y-4 hidden">
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-600 mb-1">Manager Username</label>
                            <input type="text" id="manager-user" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-600 outline-none" placeholder="Manager username">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-600 mb-1">Password</label>
                            <input type="password" id="manager-pass" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-600 outline-none" placeholder="••••••••">
                        </div>
                        <button type="submit" class="w-full py-3 bg-slate-800 text-white font-bold rounded-lg hover:bg-slate-900 transition shadow-lg">Login as Manager</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Dashboard View (Hidden by default) -->
        <div id="dashboard-view" class="hidden min-h-screen flex flex-col">
            <!-- Top Navigation -->
            <header class="bg-slate-900 text-white shadow-md z-20 flex justify-between items-center px-6 py-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-amber-600 text-white p-2 rounded-lg"><i class="fa-solid fa-glasses text-xl"></i></div>
                    <div>
                        <h2 class="font-bold text-lg leading-tight">RIZO SUNCLASSES</h2>
                        <span id="user-role-badge" class="text-xs px-2 py-0.5 rounded bg-amber-500 text-slate-900 font-semibold">Owner</span>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <span id="welcome-user-text" class="text-sm text-slate-300">Welcome, Rizwan</span>
                    <button onclick="logout()" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 rounded-lg text-sm font-semibold transition"><i class="fa-solid fa-right-from-bracket mr-1"></i> Logout</button>
                </div>
            </header>

            <div class="flex flex-1 overflow-hidden">
                <!-- Sidebar -->
                <aside class="w-64 bg-slate-800 text-slate-300 flex flex-col justify-between p-4 space-y-2 overflow-y-auto">
                    <nav id="sidebar-nav" class="space-y-1">
                        <!-- Dynamic nav items populated via JS based on role & permissions -->
                    </nav>
                    <div class="pt-4 border-t border-slate-700 text-xs text-slate-500 text-center">
                        Peshawar Board Bazar<br>&copy; 2026 Rizo Sunclasses
                    </div>
                </aside>

                <!-- Main Content Area -->
                <main id="main-content" class="flex-1 overflow-y-auto p-6 bg-slate-100">
                    <!-- Dynamic content gets injected here -->
                </main>
            </div>
        </div>
    </div>

    <!-- Receipt Print Modal -->
    <div id="receipt-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-2xl max-w-md w-full overflow-hidden flex flex-col max-h-[90vh]">
            <div class="p-4 bg-slate-900 text-white flex justify-between items-center">
                <h3 class="font-bold">Printable Receipt</h3>
                <button onclick="closeReceiptModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div id="printable-receipt" class="p-6 overflow-y-auto bg-white text-slate-800 font-mono text-sm space-y-3">
                <!-- Receipt Content -->
            </div>
            <div class="p-
